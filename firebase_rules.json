{
  "rules": {
    "home": {
      "state": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email == 'esp32@smartpanel.local'"
      },
      "commands": {
        ".read": "auth != null",
        ".write": "auth != null",
        "timestamp": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        }
      },
      "gateway": {
        "status": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.email == 'esp32@smartpanel.local'"
        }
      },
      "tvs": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "events": {
        ".read": "auth != null && auth.token.email == 'pedrorouge2022@gmail.com'",
        ".write": "auth != null && auth.token.email == 'pedrorouge2022@gmail.com'"
      },
      "pushAlerts": {
        ".read": false,
        ".write": "auth != null && auth.token.email == 'esp32@smartpanel.local'"
      }
    },
    "users": {
      "$uid": {
        "events": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid"
        }
      }
    },
    "pushTokens": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "pushSent": {
      ".read": false,
      ".write": false
    }
  }
}
